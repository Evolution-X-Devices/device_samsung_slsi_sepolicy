# Legacy /dev/ion allocator (vendor blobs and Codec2 still use it)
allow {
    adbd
    appdomain -isolated_app_all
    bootanim
    bufferhubd
    cameraserver
    dumpstate
    fingerprintd
    gatekeeperd
    gpuservice
    hal_audio
    hal_authgraph_server
    hal_camera
    hal_cas
    hal_codec2_client
    hal_codec2_server
    hal_face
    hal_fingerprint
    hal_gatekeeper
    hal_graphics_allocator
    hal_graphics_composer
    hal_hwcrypto_default
    hal_keymaster
    hal_neuralnetworks_server
    hal_sensors_default
    mediacodec
    mediaserver
    rs
    shell
    surfaceflinger
    system_server
    tee
    zygote
} ion_device:chr_file rw_file_perms;

allow { hal_keymint_server -coredomain } ion_device:chr_file r_file_perms;
allow hal_drm ion_device:chr_file rw_file_perms;

allow system_server sysfs_ion:file r_file_perms;
